# ==== Server ====
APP_ENV=development
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:3000

# ==== Security ====
# CHANGE THESE IN PRODUCTION - min 32 chars random each
QR_HMAC_SECRET=dev-secret-change-me-in-prod-min-32chars-abcdef
JWT_SECRET=dev-jwt-secret-change-in-prod-32chars-xyz789

# ==== PostgreSQL ====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trustqr
DB_SSLMODE=disable

# ==== Redis ====
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==== CORS ====
CORS_ORIGINS=http://localhost:3000

# ==== SMS / Zalo ====
# "stub" logs to console (dev). Options: "stub", "file", (add real provider later: "esms", "zns")
SMS_PROVIDER=stub

# ==== GeoIP ====
# Path to MaxMind GeoLite2-City.mmdb. Free after signup at https://www.maxmind.com
# If file missing, falls back to stub (city="Unknown"/"Local").
GEOIP_DB_PATH=./geoip/GeoLite2-City.mmdb

# ==== Label templates (print export) ====
# Local disk folder where uploaded label design files are stored.
TEMPLATE_STORAGE_DIR=./storage/templates

# ==== Next.js ====
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_INTERNAL_URL=http://localhost:8080
